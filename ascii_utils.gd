# ---------------------------------------------------
#  Zwraca listę ASCII-artów jako listę STRINGÓW
# ---------------------------------------------------
static func get_ascii_digits(num: int) -> Array[String]:
	var result: Array[String] = []
	var s := str(num)

	for ch in s:
		var d := int(ch)
		if DIGITS.has(d):
			result.append(DIGITS[d])

	return result

# ---------------------------------------------------
#  ŁĄCZY ASCII cyfry poziomo w jedną grafikę
# ---------------------------------------------------
static func stitch_ascii(digit_list: Array[String]) -> String:
	if digit_list.is_empty():
		return ""

	# Pobierz linie pierwszej cyfry
	var first_lines: PackedStringArray = digit_list[0].split("\n")
	var total_lines: int = first_lines.size()

	var output: Array[String] = []

	# Iteruj po wysokości ASCII-artu
	for i in total_lines:
		var line := ""
		for art in digit_list:
			var split: PackedStringArray = art.split("\n")
			line += split[i] + "  " # odstęp między cyframi
		output.append(line)

	# Złóż wynik w jeden String
	var result := ""
	for i in output.size():
		result += output[i]
		if i < output.size() - 1:
			result += "\n"

	return result

# ---------------------------------------------------
#  GOTOWA FUNKCJA DO UŻYCIA: zwraca ASCII liczby
# ---------------------------------------------------
static func get_ascii_number(num: int) -> String:
	return stitch_ascii(get_ascii_digits(num))

static func get_player_ascii(num_str: String) -> String:
	var num := int(num_str)
	var result := ""
	if PLAYER.has(num):
		result = PLAYER[num]
	return result
